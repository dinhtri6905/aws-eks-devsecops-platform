# ============================================================
# TERRAFORM
# ============================================================

# Terraform working directory
**/.terraform/*
.terraform.tfstate

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform lock file
# Keep this file if you want to ensure consistent provider versions across all environments.
# Uncomment the line below if you do NOT want to commit the lock file.
# .terraform.lock.hcl

# Terraform plan files
*.tfplan
*.plan

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Local backend configs
backend.hcl
backend.local.hcl

# Sensitive variables
*.tfvars
*.tfvars.json

# Local variable files
terraform.tfvars
terraform.tfvars.json

# ============================================================
# AWS
# ============================================================

# AWS credentials
.aws/

# Local credential exports
.env
.env.*
!.env.example

# ============================================================
# KUBERNETES
# ============================================================

# Local kubeconfig
kubeconfig
*.kubeconfig

# ============================================================
